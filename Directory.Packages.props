<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- docs/dependencies.md records the licence and risk review for every package here.
       The core library has no runtime packages, and that is a design rule, not an accident. -->

  <ItemGroup Label="Build">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- The last MIT release. 6.5.0 and later are AGPL-3.0 or commercial: never upgrade (see docs/dependencies.md). -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- MigraDoc 6.2.4 asks for 8.0.1, which has advisories GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx: pinned up. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
