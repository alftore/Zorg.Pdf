<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Image handling for Zorg.Pdf built on Zorg.Imaging: WebP, GIF, BMP and TIFF, EXIF orientation, sRGB conversion, and photos shrunk to the resolution they're printed at.</Description>
    <PackageTags>pdf;images;webp;exif;jpeg;png;report</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Zorg.Imaging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zorg.Pdf\Zorg.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zorg.Pdf.Tests" />
  </ItemGroup>

</Project>
