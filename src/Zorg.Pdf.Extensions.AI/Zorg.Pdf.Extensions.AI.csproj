<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Tools for AI agents that write PDF documents with Zorg.Pdf: the document schema, validation with JSON pointers, and rendering, as Microsoft.Extensions.AI functions.</Description>
    <PackageTags>pdf;ai;agents;tools;microsoft-extensions-ai;report;pdf-ua</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zorg.Pdf\Zorg.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zorg.Pdf.Tests" />
  </ItemGroup>

</Project>
