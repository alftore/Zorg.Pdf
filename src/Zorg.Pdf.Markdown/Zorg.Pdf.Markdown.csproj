<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Markdown to Zorg.Pdf documents: headings, emphasis, lists, tables, code, quotes, images and links from CommonMark and GitHub-flavoured Markdown, rendered as tagged, accessible PDF.</Description>
    <PackageTags>pdf;markdown;commonmark;gfm;pdf-ua;report</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zorg.Pdf\Zorg.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zorg.Pdf.Tests" />
  </ItemGroup>

</Project>
