<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Factur-X and ZUGFeRD e-invoices with Zorg.Pdf: the invoice's CII XML embedded in a tagged PDF/A-3, with the profile read from the XML and the metadata e-invoice software looks for.</Description>
    <PackageTags>pdf;factur-x;zugferd;xrechnung;e-invoice;cii;pdf-a-3;invoice</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zorg.Pdf\Zorg.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zorg.Pdf.Tests" />
  </ItemGroup>

</Project>
