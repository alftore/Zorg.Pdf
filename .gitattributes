# Normalise line endings in the repository; check out with the platform default.
* text=auto

*.sh text eol=lf

# Embedded byte for byte (the Factur-X XML goes into the PDF as it is), so the same on every OS.
*.xml text eol=lf

# PDF, font and image fixtures are byte-exact test data: never convert line endings in them.
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.icc binary
*.bin binary

# Hyphenation patterns ship byte for byte as published (their licences ask that the notices stay).
src/Zorg.Pdf.Hyphenation/Patterns/*.tex -text
