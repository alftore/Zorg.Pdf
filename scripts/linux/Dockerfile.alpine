# The Linux gate image: the .NET SDK on Alpine (musl) with every oracle tool the tests and checks use.
#
#   font-dejavu     a TrueType test font with bold and oblique faces, so font tests run (ZORG_REQUIRE_FONTS=1)
#   font-noto-devanagari  a fallback font for characters DejaVu Sans lacks (Devanagari)
#   harfbuzz-utils  hb-shape, the oracle for glyph advances and kerning (ZORG_REQUIRE_ORACLES=1)
#   qpdf            structural check of every PDF the smoke sample writes
#   poppler-utils   pdffonts and pdftotext: fonts embedded and subset, and text extracts back
#   mupdf-tools     renders pages, so a broken content stream fails the gate
#   py3-jsonschema  an independent JSON Schema (2020-12) validator for the document schema and the examples
#
# veraPDF runs from its own image (docker.io/verapdf/cli, pinned by digest in test-linux.sh): it bundles a glibc Java
# that doesn't run on Alpine.
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine@sha256:60a079c9d3ffc98b2968c3153b995ede679f7d6504e3ae7d2b68225a7fd84f5a

RUN apk add --no-cache bash coreutils font-dejavu font-noto-devanagari harfbuzz-utils qpdf poppler-utils mupdf-tools py3-jsonschema py3-pillow

ENV DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    ZORG_REQUIRE_FONTS=1

COPY gate-inner.sh /usr/local/bin/gate-inner.sh
RUN chmod +x /usr/local/bin/gate-inner.sh
WORKDIR /w
